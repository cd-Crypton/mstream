# TMDB API Read Access Token (from https://www.themoviedb.org/settings/api)
# Note: Used by both Vite (local dev/Cloudflare) and Docker runtime
VITE_TMDB_READ_ACCESS_TOKEN=
TMDB_READ_ACCESS_TOKEN=

# Docker Host Port (Optional, defaults to 8080)
HOST_PORT=8080

# Cloudflare Tunnel Token (Optional, for zero-port Cloudflare Tunnel)
TUNNEL_TOKEN=


# TMDB Base URL and Image CDN Endpoints
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_BACKDROP_URL=https://image.tmdb.org/t/p/w500
VITE_POSTER_URL=https://image.tmdb.org/t/p/w1280

